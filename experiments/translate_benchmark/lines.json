{
  "_note": "自寫的測試句（動漫、VTuber 直播、日常對話風格）。scene 相同的句子依序翻譯，前兩句原文當 context。",
  "lines": [
    {"id": "ja01", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "おはようございます！今日も配信始めていきます！"},
    {"id": "ja02", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "今日はみんなと一緒にホラーゲームやっていくよ。"},
    {"id": "ja03", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "怖くないもん…全然怖くないもん！"},
    {"id": "ja04", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "えっ、マジで？それはヤバくない？"},
    {"id": "ja05", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "待って待って、今のなし！もう一回やらせて！"},
    {"id": "ja06", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "スパチャありがとう！めっちゃ嬉しい！"},
    {"id": "ja07", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "草生えるｗｗｗ"},
    {"id": "ja08", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "推しが尊すぎて無理…"},
    {"id": "ja09", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "じゃあ、そろそろ締めていこうかな。"},
    {"id": "ja10", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "チャンネル登録と高評価、よろしくお願いします！"},
    {"id": "ja11", "scene": "stream", "source": "ja", "target": "zh-TW", "text": "明日の配信は夜九時からです。お楽しみに！"},
    {"id": "ja12", "scene": "battle", "source": "ja", "target": "zh-TW", "text": "お前、まだそんなこと言ってるのか。"},
    {"id": "ja13", "scene": "battle", "source": "ja", "target": "zh-TW", "text": "俺は絶対に諦めない。仲間を守るためなら何でもする。"},
    {"id": "ja14", "scene": "battle", "source": "ja", "target": "zh-TW", "text": "まさか、あいつが裏切り者だったなんて…"},
    {"id": "ja15", "scene": "battle", "source": "ja", "target": "zh-TW", "text": "行くぞ、みんな！この戦い、俺たちの勝ちだ！"},
    {"id": "ja16", "scene": "school", "source": "ja", "target": "zh-TW", "text": "先輩、ちょっといいですか？"},
    {"id": "ja17", "scene": "school", "source": "ja", "target": "zh-TW", "text": "なんでそんな顔してるの？何かあった？"},
    {"id": "ja18", "scene": "school", "source": "ja", "target": "zh-TW", "text": "心配しないで。私がついてるから。"},
    {"id": "ja19", "scene": "school", "source": "ja", "target": "zh-TW", "text": "べ、別にあんたのためにやったわけじゃないんだからね！"},
    {"id": "ja20", "scene": "daily", "source": "ja", "target": "zh-TW", "text": "ごめん、遅れちゃった。電車が止まってて。"},
    {"id": "ja21", "scene": "daily", "source": "ja", "target": "zh-TW", "text": "いただきます！うわ、このラーメンうまっ！"},
    {"id": "ja22", "scene": "daily", "source": "ja", "target": "zh-TW", "text": "この動画のソフトの情報、後でネットで調べてみるね。"},
    {"id": "en01", "scene": "en_stream", "source": "en", "target": "zh-TW", "text": "Hey chat, welcome back to the stream!"},
    {"id": "en02", "scene": "en_stream", "source": "en", "target": "zh-TW", "text": "No way, did you see that? That was insane!"},
    {"id": "en03", "scene": "en_stream", "source": "en", "target": "zh-TW", "text": "Thanks for the super chat, I really appreciate it."},
    {"id": "en04", "scene": "en_stream", "source": "en", "target": "zh-TW", "text": "Okay, let's try this boss one more time."},
    {"id": "en05", "scene": "en_stream", "source": "en", "target": "zh-TW", "text": "Honestly, I have no idea what I'm doing right now."},
    {"id": "en06", "scene": "en_stream", "source": "en", "target": "zh-TW", "text": "I can't believe it's already been a year since my debut."},
    {"id": "en07", "scene": "en_stream", "source": "en", "target": "zh-TW", "text": "Don't forget to like and subscribe!"},
    {"id": "en08", "scene": "en_drama", "source": "en", "target": "zh-TW", "text": "Wait, where did everyone go?"},
    {"id": "en09", "scene": "en_drama", "source": "en", "target": "zh-TW", "text": "We need to get out of here before it's too late."},
    {"id": "en10", "scene": "en_drama", "source": "en", "target": "zh-TW", "text": "I'm not giving up until we finish this."},
    {"id": "en11", "scene": "en_daily", "source": "en", "target": "zh-TW", "text": "The meeting got moved to Friday afternoon, so let me download the software first."},
    {"id": "zj01", "scene": "zh_ja", "source": "zh", "target": "ja", "text": "你好，很高興認識你。"},
    {"id": "zj02", "scene": "zh_ja", "source": "zh", "target": "ja", "text": "請問車站怎麼走？"},
    {"id": "zj03", "scene": "zh_ja", "source": "zh", "target": "ja", "text": "這個多少錢？可以刷卡嗎？"},
    {"id": "ze01", "scene": "zh_en", "source": "zh", "target": "en", "text": "我們明天下午三點在咖啡廳見面吧。"},
    {"id": "ze02", "scene": "zh_en", "source": "zh", "target": "en", "text": "不好意思，可以再說一次嗎？"},
    {"id": "ze03", "scene": "zh_en", "source": "zh", "target": "en", "text": "這家店的拉麵真的很好吃。"}
  ]
}
