{
  "note": "中日同形異義詞與斷詞陷阱。must：譯文要含其中任一個；forbid：譯文含任一個就算錯（直接照抄原文的同形詞，或錯誤的意思）。control 句沒有陷阱，只用來檢查有沒有「沒翻譯就輸出原文」。全部自寫。",
  "lines": [
    {"id": "zj-01", "source": "zh", "target": "ja", "text": "我今天要吃豬排便當", "must": ["カツ"], "forbid": ["排泄", "糞", "排便"]},
    {"id": "zj-02", "source": "zh", "target": "ja", "text": "午餐吃豬排便當好了", "must": ["カツ"], "forbid": ["排泄", "糞", "排便"]},
    {"id": "zj-03", "source": "zh", "target": "ja", "text": "他很愛面子，不會承認的", "must": ["プライド", "面子", "メンツ", "体面", "見栄"], "forbid": ["顔を立て"]},
    {"id": "zj-04", "source": "zh", "target": "ja", "text": "我老婆在家等我", "must": ["妻", "嫁", "奥さん", "家内", "女房", "かみさん"], "forbid": ["老婆", "おばあ", "老女"]},
    {"id": "zj-05", "source": "zh", "target": "ja", "text": "她丈夫是醫生", "must": ["夫", "旦那", "主人"], "forbid": ["丈夫", "頑丈"]},
    {"id": "zj-06", "source": "zh", "target": "ja", "text": "我每天早上都看電視新聞", "must": ["ニュース"], "forbid": ["新聞"]},
    {"id": "zj-07", "source": "zh", "target": "ja", "text": "他很勉強才答應了", "must": ["しぶしぶ", "渋々", "仕方なく", "嫌々", "いやいや", "やむを得ず", "不承不承", "無理"], "forbid": ["勉強"]},
    {"id": "zj-08", "source": "zh", "target": "ja", "text": "我們開汽車去海邊吧", "must": ["車"], "forbid": ["汽車"]},
    {"id": "zj-09", "source": "zh", "target": "ja", "text": "我娘做的菜最好吃", "must": ["母", "おふくろ", "お袋", "ママ", "かあ"], "forbid": ["娘"]},
    {"id": "zj-10", "source": "zh", "target": "ja", "text": "這碗湯太燙了", "must": ["スープ", "汁"], "forbid": ["お湯"]},
    {"id": "zj-11", "source": "zh", "target": "ja", "text": "大家晚安，明天見", "must": ["みんな", "皆", "みなさん"], "forbid": ["大家"]},
    {"id": "zj-12", "source": "zh", "target": "ja", "text": "我每天走路去學校", "must": ["歩"], "forbid": ["走って", "走る"]},
    {"id": "zj-13", "source": "zh", "target": "ja", "text": "你在找什麼東西", "must": ["物", "もの", "何を", "何か"], "forbid": ["東西"]},
    {"id": "zj-14", "source": "zh", "target": "ja", "text": "我明天早上還要去公司工作", "must": ["仕事", "働", "出勤"], "forbid": ["工作"]},
    {"id": "zj-15", "source": "zh", "target": "ja", "text": "貓咪在床上睡覺", "must": ["ベッド", "寝床", "布団"], "forbid": ["床で", "床に", "床の上"]},
    {"id": "zj-16", "source": "zh", "target": "ja", "text": "這次直播的企劃很有意思", "must": ["面白", "興味深", "おもしろ"], "forbid": ["意思"]},
    {"id": "zj-17", "source": "zh", "target": "ja", "text": "我們分手吧", "must": ["別れ"], "forbid": ["分手"]},
    {"id": "zj-18", "source": "zh", "target": "ja", "text": "這部動畫的結局很感人", "must": ["感動", "泣け", "心に"], "forbid": ["感人"]},
    {"id": "zj-19", "source": "zh", "target": "ja", "text": "他是個很大方的人，常常請客", "must": ["気前", "太っ腹", "おおらか"], "forbid": ["大方"]},
    {"id": "zj-20", "source": "zh", "target": "ja", "text": "我的電腦好像中毒了", "must": ["ウイルス", "感染"], "forbid": ["中毒"]},
    {"id": "zj-21", "source": "zh", "target": "ja", "text": "這部電影真的很無聊", "must": ["つまらな", "退屈"], "forbid": ["無聊"]},
    {"id": "zj-22", "source": "zh", "target": "ja", "text": "她平常很用功，考試一定沒問題", "must": ["勉強熱心", "頑張", "努力", "勉強して", "よく勉強"], "forbid": ["用功"]},
    {"id": "zj-23", "source": "zh", "target": "ja", "text": "我先生這禮拜去日本出差了", "must": ["夫", "主人", "旦那"], "forbid": ["先生"]},
    {"id": "zj-24", "source": "zh", "target": "ja", "text": "你不要一味地責怪他", "must": ["ばかり", "一方的", "ひたすら", "むやみ", "一概に"], "forbid": ["一味"]},
    {"id": "zj-c1", "source": "zh", "target": "ja", "text": "謝謝大家今天來看我的直播", "control": true},
    {"id": "zj-c2", "source": "zh", "target": "ja", "text": "明天下午三點我們在車站見面", "control": true},
    {"id": "zj-c3", "source": "zh", "target": "ja", "text": "這個遊戲真的太難了吧", "control": true},
    {"id": "zj-c4", "source": "zh", "target": "ja", "text": "抱歉剛剛網路斷線了", "control": true},
    {"id": "zj-c5", "source": "zh", "target": "ja", "text": "我們一起去看煙火吧", "control": true},
    {"id": "zj-c6", "source": "zh", "target": "ja", "text": "這次的新衣裝超可愛的", "control": true},

    {"id": "jz-01", "source": "ja", "target": "zh-TW", "text": "昨日、友達に手紙を書いた", "must": ["信"], "forbid": ["手紙", "衛生紙"]},
    {"id": "jz-02", "source": "ja", "target": "zh-TW", "text": "今日の配信はすごく勉強になった", "must": ["學到", "收穫", "受益", "長知識", "學習", "獲益"], "forbid": ["勉強"]},
    {"id": "jz-03", "source": "ja", "target": "zh-TW", "text": "この箱は丈夫だから大丈夫", "must": ["堅固", "結實", "耐用", "牢固", "堅韌", "耐"], "forbid": ["丈夫"]},
    {"id": "jz-04", "source": "ja", "target": "zh-TW", "text": "先月、娘が生まれました", "must": ["女兒"], "forbid": ["娘"]},
    {"id": "jz-05", "source": "ja", "target": "zh-TW", "text": "大家さんに家賃を払わなきゃ", "must": ["房東"], "forbid": ["大家"]},
    {"id": "jz-06", "source": "ja", "target": "zh-TW", "text": "毎朝、新聞を読んでいます", "must": ["報紙", "報"], "forbid": ["新聞"]},
    {"id": "jz-07", "source": "ja", "target": "zh-TW", "text": "汽車に乗って田舎に帰った", "must": ["火車"], "forbid": ["汽車"]},
    {"id": "jz-08", "source": "ja", "target": "zh-TW", "text": "みんなに迷惑をかけてごめん", "must": ["麻煩", "困擾", "添亂", "打擾", "給大家添"], "forbid": ["迷惑"]},
    {"id": "jz-09", "source": "ja", "target": "zh-TW", "text": "床に座って配信を見てた", "must": ["地板", "地上"], "forbid": ["床上"]},
    {"id": "jz-10", "source": "ja", "target": "zh-TW", "text": "犬が走ってきた", "must": ["跑"], "forbid": ["走過來", "走來"]},
    {"id": "jz-11", "source": "ja", "target": "zh-TW", "text": "階段で転んで怪我をした", "must": ["受傷", "受了傷", "傷"], "forbid": ["怪我"]},
    {"id": "jz-12", "source": "ja", "target": "zh-TW", "text": "夕飯の用意はできた？", "must": ["準備", "好了", "弄好"], "forbid": ["用意"]},
    {"id": "jz-13", "source": "ja", "target": "zh-TW", "text": "ちょっと留守番をお願いね", "must": ["看家", "顧家", "看門"], "forbid": ["留守"]},
    {"id": "jz-14", "source": "ja", "target": "zh-TW", "text": "この料理は本当に油断できない", "must": ["大意", "掉以輕心", "鬆懈", "輕忽", "小看"], "forbid": ["油斷"]},
    {"id": "jz-c1", "source": "ja", "target": "zh-TW", "text": "みんな、今日も来てくれてありがとう！", "control": true},
    {"id": "jz-c2", "source": "ja", "target": "zh-TW", "text": "このボス強すぎない？", "control": true},
    {"id": "jz-c3", "source": "ja", "target": "zh-TW", "text": "スパチャありがとうございます！", "control": true},
    {"id": "jz-c4", "source": "ja", "target": "zh-TW", "text": "明日は朝から歌枠やります", "control": true}
  ]
}
