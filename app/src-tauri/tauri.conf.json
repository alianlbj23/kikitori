{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kikitori",
  "version": "0.3.1",
  "identifier": "io.github.alianlbj23.kikitori",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "kikitori",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "kikitori 字幕",
        "width": 960,
        "height": 200,
        "minWidth": 360,
        "minHeight": 96,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "MIT",
    "category": "Education",
    "shortDescription": "即時語音翻譯與雙語字幕",
    "macOS": {
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "recommends": ["fonts-noto-cjk"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFMEE1RTFFOTk4NDQ1MUYKUldRZlJZU1pIbDRLSGszSTBOYmh1ODgvNWMvdFdMcGRaZmRjSWI4dklyYW8ybmpVNzliY0V1cm8K",
      "endpoints": [
        "https://github.com/alianlbj23/kikitori/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
