{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: engine control, settings, models, overlay control, updates, and opening the NVIDIA CUDA EULA page (the only URL it may open).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://docs.nvidia.com/cuda/eula/index.html" }]
    },
    "allow-engine-info",
    "allow-hardware-detect",
    "allow-models-list",
    "allow-models-download",
    "allow-models-validate",
    "allow-devices-list",
    "allow-settings-get",
    "allow-settings-set",
    "allow-settings-apply-recommendation",
    "allow-session-start",
    "allow-session-stop",
    "allow-engine-restart",
    "allow-bridge-status",
    "allow-app-about",
    "allow-open-third-party-licenses",
    "allow-overlay-get-state",
    "allow-overlay-set-style",
    "allow-overlay-set-click-through",
    "allow-overlay-set-visible",
    "allow-update-check",
    "allow-update-install"
  ]
}
